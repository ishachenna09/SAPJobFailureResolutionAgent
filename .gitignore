# ==============================================================================
# Git Ignore Configuration - SAP Job Failure Resolution Agent
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!*.env.example
!.env.example
!backend/.env.example
!frontend/.env.example
*.pem
*.key
*.cert
*.pfx

# ------------------------------------------------------------------------------
# 2. Database & Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
backend/*.db
backend/*.sqlite
backend/*.sqlite3
sap_jobs.db
backend/sap_jobs.db

# ------------------------------------------------------------------------------
# 3. Python & Backend
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
backend/**/__pycache__/
backend/**/__pycache__/*

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/
backend/env/

