# ==========================================================
# SAP Autonomous Job Failure Resolution Agent — Configuration
# ==========================================================

# Application Settings
PROJECT_NAME="SAP Job Failure Resolution Agent"
VERSION="1.0.0"
API_V1_STR="/api"

# Database (SQLite local database)
DATABASE_URL="sqlite:///./sap_jobs.db"

# SAP Integration Mode
# Options for JOB_PLATFORM: mock (Local SAP simulator) or sap_btp (Real SAP BTP Job Scheduling Service REST API)
JOB_PLATFORM="mock"
SAP_MODE="MOCK"

# Real SAP BTP Job Scheduling Service Credentials (keep secret - never expose to browser)
SAP_BASE_URL=""
SAP_CLIENT_ID=""
SAP_CLIENT_SECRET=""
SAP_TOKEN_URL=""
SAP_JOB_LOOKBACK_MINUTES=30
SAP_JOB_MAX_RUNS=100

# AI Provider Configuration
# Options:
# - FALLBACK: Zero external API keys needed (uses fast, deterministic BASIS rule engine)
# - GEMINI: Uses Google Gemini (requires GEMINI_API_KEY)
# - GROQ: Uses Groq high-speed Llama 3 (requires GROQ_API_KEY)
AI_PROVIDER="FALLBACK"

# Gemini API Key (optional - get from https://aistudio.google.com/)
GEMINI_API_KEY=""

# Groq API Key (optional - get from https://console.groq.com/)
GROQ_API_KEY=""

# Event deduplication TTL in seconds (1 hour default)
EVENT_DEDUPLICATION_TTL=3600